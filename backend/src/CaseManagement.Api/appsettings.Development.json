{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",

      // EF Core logs every statement it executes at Information level. During seeding that is
      // 10,000 INSERTs, which buries anything worth reading. Raise this to "Information" when
      // you want to inspect the generated SQL and confirm that filtering, sorting and paging
      // are happening in the database rather than in memory.
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Migrations": "Information"
    }
  }
}
