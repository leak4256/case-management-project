# Copy this file to .env before running `docker compose up`.
#
#   cp .env.example .env      (bash)
#   copy .env.example .env    (cmd)
#
# .env is git-ignored so real values never reach the repository.
# SQL Server requires at least 8 characters from 3 of these 4 groups:
# uppercase, lowercase, digits, symbols.

MSSQL_SA_PASSWORD=LocalDev_2026!
